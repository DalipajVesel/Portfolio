{
  "schema_version": "1.0",
  "scenario_meta": {
    "id": "icu_scenario_asthma_v1",
    "title": "ΜΕΘ: Οξεία Κρίση Άσθματος",
    "description": "Σενάριο διαχείρισης σοβαρού βρογχόσπασμου με οξυγονοθεραπεία και υποχρεωτική ψηφιακή τεκμηρίωση.",
    "estimated_duration_minutes": 7,
    "difficulty": "Intermediate",
    "learning_goals": [
      "Αναγνώριση κλινικού συναγερμού (SpO2)",
      "Άμεση αντιμετώπιση βρογχόσπασμου",
      "Χρήση Documentation Gates στο e-Health module",
      "Τήρηση πρωτοκόλλου κλιμάκωσης"
    ]
  },
  "initial_state": {
    "time_elapsed": 0,
    "current_score": 100,
    "flags": {
      "assessment_complete": false,
      "oxygen_adjusted": false,
      "documentation_1_complete": false,
      "escalation_complete": false,
      "documentation_2_complete": false
    },
    "vitals": {
      "hr": 122,
      "spo2": 88,
      "rr": 30,
      "bp": "140/90",
      "temp": 37.2
    },
    "ui": {
      "active_hotspots": [
        "hs_monitor",
        "hs_patient",
        "hs_ventilator",
        "hs_ehr",
        "hs_call"
      ],
      "monitor_alert": false
    }
  },
  "hotspots": [
    { "id": "hs_monitor", "label": "Μόνιτορ Ζωτικών (Monitor)" },
    { "id": "hs_patient", "label": "Ασθενής / Κλίνη (Patient)" },
    { "id": "hs_ventilator", "label": "Αναπνευστήρας (Ventilator)" },
    { "id": "hs_ehr", "label": "Τερματικό EHR (e-Health)" },
    { "id": "hs_call", "label": "Κουμπί Κλήσης (Call Button)" }
  ],
  "ehr_config": {
    "forms": {
      "assessment_form": {
        "title": "Κλινική Αξιολόγηση",
        "fields": ["observation", "skin_color", "consciousness"]
      },
      "intervention_form": {
        "title": "Παρεμβάσεις / Ρυθμίσεις",
        "fields": ["device", "fiO2_setting", "flow_rate"]
      },
      "communication_log": {
        "title": "Ημερολόγιο Επικοινωνίας",
        "fields": ["recipient", "reason", "outcome"]
      }
    }
  },
  "rules": {
    "global_rules": [
      {
        "id": "rule_hypoxia_alarm",
        "condition": {
          "vitals.spo2": { "lt": 90 }
        },
        "effects": [
          { "type": "ui_visual", "target": "hs_monitor", "state": "blinking_red" },
          { "type": "ui_toast", "style": "danger", "message": "ΣΥΝΑΓΕΡΜΟΣ: SpO2 < 90%" }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "n1_start",
      "type": "message",
      "text": "Νεαρός ασθενής στην κλίνη 2 με γνωστό άσθμα εμφανίζει σοβαρό βρογχόσπασμο: έντονος συριγμός και δύσπνοια. Το μόνιτορ χτυπάει, SpO2: 88%, RR: 30.",
      "next_node_id": "n2_initial_decision"
    },
    {
      "id": "n2_initial_decision",
      "type": "decision",
      "text": "Ποια είναι η πρώτη σου ενέργεια;",
      "options": [
        {
          "id": "opt_assess",
          "label": "Άμεση Αξιολόγηση Ασθενούς",
          "target_hotspot": "hs_patient",
          "effects": {
            "score_delta": 10,
            "state_update": { "flags.assessment_complete": true },
            "toast": { "style": "success", "message": "Ακούς εκτεταμένο συριγμό και παρατεταμένη εκπνοή." }
          },
          "next_node_id": "n3_intervention"
        },
        {
          "id": "opt_check_monitor",
          "label": "Έλεγχος Ζωτικών στο Μόνιτορ",
          "target_hotspot": "hs_monitor",
          "effects": {
            "score_delta": 5,
            "toast": { "style": "info", "message": "Επιβεβαιώνεις SpO2 88% και ταχύπνοια." }
          },
          "next_node_id": "n3_intervention"
        }
      ],
      "timeout": {
        "seconds": 30,
        "on_timeout_effects": {
          "vitals_update": { "spo2": 84, "hr": 130 },
          "score_delta": -10,
          "toast": { "style": "danger", "message": "Καθυστέρηση! Το SpO2 έπεσε στο 84%." }
        },
        "next_node_id": "n3_intervention"
      }
    },
    {
      "id": "n3_intervention",
      "type": "decision",
      "text": "Ο ασθενής χρειάζεται άμεση αντιμετώπιση του βρογχόσπασμου και οξυγόνο.",
      "options": [
        {
          "id": "opt_treat",
          "label": "Νεφελοποίηση βρογχοδιασταλτικού + O2 (μάσκα)",
          "target_hotspot": "hs_ventilator",
          "effects": {
            "state_update": { "flags.oxygen_adjusted": true },
            "vitals_update": { "spo2": 94, "hr": 105, "rr": 22 },
            "score_delta": 20,
            "toast": { "style": "success", "message": "Ο συριγμός υποχωρεί, το SpO2 ανεβαίνει." }
          },
          "next_node_id": "n4_gate_documentation_1"
        },
        {
          "id": "opt_wait",
          "label": "Αναμονή - μόνο παρακολούθηση",
          "target_hotspot": "hs_patient",
          "effects": {
            "vitals_update": { "spo2": 82, "hr": 135, "rr": 34 },
            "score_delta": -20,
            "toast": { "style": "danger", "message": "Κρίσιμο λάθος. Κίνδυνος αναπνευστικής ανεπάρκειας." }
          },
          "next_node_id": "n4_gate_documentation_1"
        }
      ]
    },
    {
      "id": "n4_gate_documentation_1",
      "type": "gate",
      "text": "GATE: Τεκμηρίωση Αξιολόγησης & Παρέμβασης",
      "description": "Το σύστημα μπλοκάρει τη συνέχεια μέχρι να συμπληρωθούν τα πεδία στο EHR.",
      "gate_requirements": {
        "target_hotspot": "hs_ehr",
        "required_forms": [
          { "form_id": "assessment_form", "fields": ["observation"] },
          { "form_id": "intervention_form", "fields": ["fiO2_setting"] }
        ]
      },
      "feedback_blocked": "Πρέπει να συμπληρώσεις το EHR για να προχωρήσεις.",
      "feedback_success": "Η τεκμηρίωση αποθηκεύτηκε επιτυχώς.",
      "effects_on_pass": {
        "state_update": { "flags.documentation_1_complete": true },
        "score_delta": 10
      },
      "next_node_id": "n5_reassessment"
    },
    {
      "id": "n5_reassessment",
      "type": "message",
      "text": "10 λεπτά αργότερα... Ο συριγμός έχει μειωθεί (SpO2: 94%), αλλά ο ασθενής παραμένει ταχύπνοος και κουρασμένος.",
      "effects": {
        "vitals_update": { "spo2": 94, "hr": 100, "rr": 24 }
      },
      "next_node_id": "n6_escalation_decision"
    },
    {
      "id": "n6_escalation_decision",
      "type": "decision",
      "text": "Χρειάζεται περαιτέρω ενέργεια;",
      "options": [
        {
          "id": "opt_call_doc",
          "label": "Κλήση Πνευμονολόγου (Κλιμάκωση)",
          "target_hotspot": "hs_call",
          "effects": {
            "state_update": { "flags.escalation_complete": true },
            "score_delta": 10,
            "toast": { "style": "success", "message": "Ενημερώθηκε ο ειδικός πνευμονολόγος." }
          },
          "next_node_id": "n7_gate_documentation_2"
        },
        {
          "id": "opt_wait",
          "label": "Όχι, συνεχίζω παρακολούθηση",
          "target_hotspot": "hs_monitor",
          "effects": {
            "score_delta": 0,
            "toast": { "style": "info", "message": "Συνεχίζεις την παρακολούθηση." }
          },
          "next_node_id": "n8_end_scenario"
        }
      ]
    },
    {
      "id": "n7_gate_documentation_2",
      "type": "gate",
      "text": "GATE: Καταγραφή Επικοινωνίας",
      "description": "Κατάγραψε την κλήση στο Communication Log.",
      "gate_requirements": {
        "target_hotspot": "hs_ehr",
        "required_forms": [
          { "form_id": "communication_log", "fields": ["recipient", "outcome"] }
        ]
      },
      "feedback_blocked": "Εκκρεμεί η καταγραφή της κλήσης στο EHR.",
      "feedback_success": "Η επικοινωνία καταγράφηκε.",
      "effects_on_pass": {
        "state_update": { "flags.documentation_2_complete": true },
        "score_delta": 5
      },
      "next_node_id": "n8_end_scenario"
    },
    {
      "id": "n8_end_scenario",
      "type": "end",
      "text": "Το σενάριο ολοκληρώθηκε.",
      "debrief_config": {
        "show_score": true,
        "show_decision_path": true,
        "highlight_missed_docs": true,
        "export_log": true
      }
    }
  ],
  "logging": {
    "enabled": true,
    "log_events": [
      "NODE_ENTER",
      "HOTSPOT_INTERACTION",
      "OPTION_SELECTED",
      "EHR_SUBMIT",
      "VITALS_CHANGE",
      "GATE_CHECK",
      "TIMEOUT"
    ],
    "export_format": "JSON"
  }
}
